    "/api/{simulacao}/fora-da-faixa": {
      "get": {
        "operationId": "fora_da_faixa_api__simulacao__fora_da_faixa_get",
        "parameters": [
          {
            "in": "path",
            "name": "simulacao",
            "required": true,
            "schema": {
              "title": "Simulacao",
              "type": "string"
            }
          },
          {
            "description": "Horário local do hall se vier sem fuso",
            "in": "query",
            "name": "inicio",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Horário local do hall se vier sem fuso",
              "title": "Inicio"
            }
          },
          {
            "description": "Fim da janela (exclusivo)",
            "in": "query",
            "name": "fim",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Fim da janela (exclusivo)",
              "title": "Fim"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/RackForaDaFaixa"
                  },
                  "title": "Response Fora Da Faixa Api  Simulacao  Fora Da Faixa Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Fora Da Faixa"
      }
    },
    "/api/{simulacao}/gabarito": {
      "get": {
        "description": "Os incidentes injetados pelo simulador. Só existe porque os dados são simulados: serve para comparar o que aconteceu com o que o produto detectou. A IA não tem acesso a ele.",
        "operationId": "gabarito_api__simulacao__gabarito_get",
        "parameters": [
          {
            "in": "path",
            "name": "simulacao",
            "required": true,
            "schema": {
              "title": "Simulacao",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Incidente"
                  },
                  "title": "Response Gabarito Api  Simulacao  Gabarito Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Gabarito"
      }
    },
    "/api/{simulacao}/mapa": {
      "get": {
        "operationId": "mapa_api__simulacao__mapa_get",
        "parameters": [
          {
            "in": "path",
            "name": "simulacao",
            "required": true,
            "schema": {
              "title": "Simulacao",
              "type": "string"
            }
          },
          {
            "description": "Padrão: o fim da simulação",
            "in": "query",
            "name": "instante",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Padrão: o fim da simulação",
              "title": "Instante"
            }
          },
          {
            "in": "query",
            "name": "tipo",
            "required": false,
            "schema": {
              "default": "temp_entrada",
              "enum": [
                "temp_entrada",
                "temp_saida",
                "potencia_kw"
              ],
              "title": "Tipo",
              "type": "string"
            }
          },
          {
            "description": "Só para temp_entrada",
            "in": "query",
            "name": "altura",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "base",
                    "meio",
                    "topo"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Só para temp_entrada",
              "title": "Altura"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MapaTermico"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Mapa"
      }
    },
